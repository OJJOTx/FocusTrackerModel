{
  "name": "focus-tracker",
  "version": "1.0.0",
  "description": "A reusable, modular, local real-time Visual Attention Monitoring Engine for Electron applications",
  "main": "dist/attention/index.js",
  "types": "dist/attention/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "tsc -p tsconfig.json && esbuild demo/renderer.ts --bundle --outfile=demo/renderer.bundle.js --platform=browser --format=esm --external:@mediapipe/tasks-vision",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "download-models": "ts-node scripts/download-models.ts",
    "demo": "npm run build:demo && electron dist/demo/main.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "attention",
    "gaze",
    "eye-tracking",
    "face-detection",
    "mediapipe",
    "electron",
    "webcam",
    "computer-vision"
  ],
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "electron": "^30.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
